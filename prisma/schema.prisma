generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  displayName   String?     // public name on shared content; chosen on first share
  accounts      Account[]
  sessions      Session[]
  readVerses        ReadVerse[]
  completedChapters CompletedChapter[]
  favoriteVerses    FavoriteVerse[]
  favoriteChapters  FavoriteChapter[]
  verseNotes        VerseNote[]
  shares            Share[]
  shareLikes        ShareLike[]
  shareComments     ShareComment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ReadVerse {
  id      String   @id @default(cuid())
  userId  String
  book    String
  chapter Int
  verse   Int
  readAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, book, chapter, verse])
}

model UnknownRoot {
  id            Int       @id @default(autoincrement())
  strongsNum    String    @unique   // "H776"
  lemmaHe       String              // "אֶרֶץ"
  lemmaPlain    String              // "ארץ"
  xlit          String              // "erets"
  definition    String              // "earth, land"
  derivation    String              // "from an unused root..."
  issue         String              // "unused_root" | "no_parent"
  suggestedRoot String?             // הצעת שורש
  suggestedAt   DateTime?

  @@index([lemmaPlain])
}

model StrongsEntry {
  number      String  @id       // "H6817"
  lemmaHe     String            // "צָעַק" (עם ניקוד)
  lemmaPlain  String            // "צעק" (ללא ניקוד)
  xlit        String            // "tsaaq"
  definition  String            // "to cry out"
  derivedFrom String            // "H6817,H1234" (מופרד בפסיק)
  isPrimitive Boolean @default(false)

  @@index([lemmaPlain])
}

model VerseText {
  id          Int    @id @default(autoincrement())
  book        String
  chapter     Int
  verse       Int
  verseIndex  Int
  text        String
  plainText   String
  firstLetter String
  lastLetter  String

  @@unique([book, chapter, verse])
  @@index([firstLetter, lastLetter])
  @@index([verseIndex])
}

model WordEntry {
  id         Int    @id @default(autoincrement())
  book       String
  chapter    Int
  verse      Int
  verseIndex Int
  wordNum    Int
  word       String
  lemma      String
  morph      String
  plain      String

  @@unique([book, chapter, verse, wordNum])
  @@index([lemma])
  @@index([verseIndex])
  @@index([book, chapter, verse])
}

model CompletedChapter {
  id          String   @id @default(cuid())
  userId      String
  book        String
  chapter     Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, book, chapter])
}

model FavoriteVerse {
  id        String   @id @default(cuid())
  userId    String
  book      String
  chapter   Int
  verse     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, book, chapter, verse])
}

// Personal notes on a verse. Keyed by (userId, book, chapter, verse) rather than FavoriteVerse.id,
// though the API keeps them in step: adding a note favorites the verse, unfavoriting deletes its notes.
model VerseNote {
  id        String   @id @default(cuid())
  userId    String
  book      String
  chapter   Int
  verse     Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  share     Share?

  @@index([userId, book, chapter])
}

// Something a user published to the community page (/community). `type` allows more kinds of
// shares later; today only "note" exists, linked to its VerseNote — the share shows the note's
// current text and is deleted with it.
model Share {
  id        String         @id @default(cuid())
  userId    String
  type      String
  noteId    String?        @unique
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      VerseNote?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  likes     ShareLike[]
  comments  ShareComment[]

  @@index([createdAt])
}

model ShareLike {
  id        String   @id @default(cuid())
  shareId   String
  userId    String
  createdAt DateTime @default(now())
  share     Share    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareId, userId])
}

// Threaded comments: parentId points at the comment being replied to (null = top level),
// with no depth limit. A comment that has replies is soft-deleted (deleted = true, text
// cleared) so the thread below it survives.
model ShareComment {
  id        String         @id @default(cuid())
  shareId   String
  userId    String
  parentId  String?
  text      String
  deleted   Boolean        @default(false)
  createdAt DateTime       @default(now())
  share     Share          @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    ShareComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ShareComment[] @relation("Replies")

  @@index([shareId])
}

model FavoriteChapter {
  id        String   @id @default(cuid())
  userId    String
  book      String
  chapter   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, book, chapter])
}
